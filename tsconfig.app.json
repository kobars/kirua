{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    /* Paths resolve relative to this file — `baseUrl` is deprecated in TS 6. */
    "paths": {
      "@/*": ["./src/*"],
      /* The example app imports the published package name, as a consumer
       * would, resolved to the source here. `src` keeps `@/`. */
      "@kobars/kirua": ["./src/components/index.ts"],
      "@kobars/kirua/styles.css": ["./src/index.css"]
    },
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting.
     *
     * There is no `"strict": true` line and strict IS on — TypeScript 6 turns
     * it on by default. Do not "fix" the absence by adding a redundant line.
     * These two are the opt-ins that sit beyond strict. */
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /* `vitest.shims.d.ts` is named explicitly because it sits outside `src` and
   * carries the browser-matcher type references the test suite needs. */
  "include": ["src", "examples", ".storybook", "vitest.shims.d.ts"],
  /* The example app's Vite config belongs to the node project: it imports
   * `vite` and runs under Node. Listed in both, it would compile twice under
   * different `module` settings. */
  "exclude": ["examples/vite.config.ts", "examples/highlight.plugin.ts", "examples/dist"]
}
