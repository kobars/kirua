{
  "name": "kirua",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "pnpm": ">=10"
  },
  "browserslist": [
    "chrome >= 120",
    "edge >= 120",
    "safari >= 16.4",
    "firefox >= 128"
  ],
  "scripts": {
    "dev": "vite",
    "board": "vite --open /board.html",
    "example": "vite --config examples/vite.config.ts",
    "example:source": "KIRUA_SOURCE=1 vite --config examples/vite.config.ts",
    "build:examples": "vite build --config examples/vite.config.ts",
    "build:lib": "node tools/build-lib.mjs",
    "size:components": "pnpm build:lib && node tools/component-size.mjs",
    "check:install": "node tools/consumer-install.mjs",
    "pack:check": "cd packages/kirua && npm pack --dry-run",
    "check:responsive": "pnpm build:examples && node tools/responsive-check.mjs",
    "check:a11y": "pnpm build:examples && node tools/a11y-check.mjs",
    "check:dogfood": "node --test tools/dogfood-appearance.test.mjs && node tools/dogfood-check.mjs",
    "check:usage": "node tools/component-usage.mjs",
    "check:classname": "node tools/no-classname-check.mjs",
    "check:perf": "pnpm build:examples && node tools/perf-check.mjs",
    "check:examples": "KIRUA_SOURCE=1 pnpm build:examples && pnpm check:dogfood && node tools/component-usage.mjs && node tools/no-classname-check.mjs && node tools/responsive-check.mjs && node tools/a11y-check.mjs && node tools/perf-check.mjs && node tools/example-journeys.mjs",
    "build": "tsc -b && vite build && node tools/dead-classes.mjs && node tools/size-budget.mjs",
    "lint": "oxlint --deny-warnings",
    "audit": "pnpm audit --audit-level moderate",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest --run",
    "test:webkit": "KIRUA_WEBKIT=1 vitest --run --project webkit",
    "test:coverage": "vitest --run --coverage",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"examples/**/*.{ts,tsx,css}\" \"*.{ts,json,mjs}\" \"tools/*.mjs\" \".storybook/**/*.{ts,tsx,css}\" \"src/**/*.mdx\" \"README.md\" \"CONTRIBUTING.md\" \"packages/kirua/*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"examples/**/*.{ts,tsx,css}\" \"*.{ts,json,mjs}\" \"tools/*.mjs\" \".storybook/**/*.{ts,tsx,css}\" \"src/**/*.mdx\" \"README.md\" \"CONTRIBUTING.md\" \"packages/kirua/*.{json,md}\"",
    "check": "tsc -b && node --test tools/dogfood-appearance.test.mjs && node tools/dead-classes.mjs && oxlint --deny-warnings && prettier --check \"src/**/*.{ts,tsx,css}\" \"examples/**/*.{ts,tsx,css}\" \"*.{ts,json,mjs}\" \"tools/*.mjs\" \".storybook/**/*.{ts,tsx,css}\" \"src/**/*.mdx\" \"README.md\" \"CONTRIBUTING.md\" \"packages/kirua/*.{json,md}\" && vitest --run --coverage && KIRUA_WEBKIT=1 vitest --run --project webkit",
    "check:all": "pnpm check && pnpm build && pnpm size:components && pnpm check:install && pnpm check:examples && pnpm check:storybook",
    "dead-classes": "node tools/dead-classes.mjs",
    "check:storybook": "pnpm build-storybook && node tools/storybook-theme-check.mjs",
    "check:journeys": "pnpm build:examples && node tools/example-journeys.mjs",
    "check:lighthouse": "pnpm build:examples && node tools/lighthouse-examples.mjs",
    "lighthouse:compare": "node tools/lighthouse-compare.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.21",
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-aspect-ratio": "^1.1.16",
    "@radix-ui/react-avatar": "^1.2.7",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-collapsible": "^1.1.21",
    "@radix-ui/react-context-menu": "^2.3.8",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-direction": "^1.1.5",
    "@radix-ui/react-dismissable-layer": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-hover-card": "^1.1.24",
    "@radix-ui/react-menubar": "^1.1.25",
    "@radix-ui/react-navigation-menu": "^1.3.0",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-progress": "^1.1.17",
    "@radix-ui/react-radio-group": "^1.4.8",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slider": "^1.5.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-toggle": "^1.1.19",
    "@radix-ui/react-toggle-group": "^1.1.20",
    "@radix-ui/react-tooltip": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@kobars/kirua": "^0.5.0",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.13.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shiki": "^4.5.0",
    "storybook": "^10.5.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
